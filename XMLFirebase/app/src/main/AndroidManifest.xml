<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XMLFirebase"
        tools:targetApi="31">
        <activity
            android:name=".activities.ForgetPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".activities.SettingActivity"
            android:exported="false" /> <!-- LoginActivity is the single launcher activity -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- SignUpActivity should not be a launcher -->
        <activity
            android:name=".activities.SignUpActivity"
            android:exported="false" /> <!-- MainActivity should not be a launcher, as LoginActivity handles redirection -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" /> <!-- Set exported to false as it's not a direct entry point from outside -->
        <activity
            android:name=".activities.UpdateUserActivity"
            android:exported="false" />
        <activity
            android:name=".activities.AddUserActivity"
            android:exported="false" />
    </application>

</manifest>